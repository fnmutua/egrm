{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@egrm/console#dev": {
      "dependsOn": ["@egrm/api#dev", "^build"],
      "cache": false,
      "persistent": true
    },
    "@egrm/portal#dev": {
      "dependsOn": ["@egrm/api#dev", "^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
